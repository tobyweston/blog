---
// Small original illustration of a chef giving a thumbs up, used by
// ExampleCallout. Kept as its own component so it can be reused or swapped
// out independently of the callout's layout and styling.
interface Props {
	class?: string;
	title?: string;
}

const { class: className, title = 'Illustration of a chef giving a thumbs up' } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 120 120"
	xmlns="http://www.w3.org/2000/svg"
	role="img"
	aria-label={title}
>
	<title>{title}</title>
	<circle cx="60" cy="60" r="58" fill="#ffffff" stroke="#c7cdf5" stroke-width="2" />

	<!-- toque (chef hat) -->
	<path
		d="M40 42c-7 0-12-5-12-12 0-6 4-11 10-12-1-7 4-13 11-13 4 0 7 2 9 5 2-3 5-5 9-5 6 0 11 5 11 11 0 1 0 2-1 3 6 1 10 6 10 12 0 7-5 12-12 12z"
		fill="#f5f6fb"
		stroke="#2d2a26"
		stroke-width="2.5"
		stroke-linejoin="round"
	/>
	<rect x="39" y="38" width="42" height="10" rx="3" fill="#ffffff" stroke="#2d2a26" stroke-width="2.5" />

	<!-- face -->
	<ellipse cx="60" cy="63" rx="20" ry="19" fill="#f2c08a" stroke="#2d2a26" stroke-width="2.5" />

	<!-- ears -->
	<circle cx="40" cy="64" r="5" fill="#f2c08a" stroke="#2d2a26" stroke-width="2" />
	<circle cx="80" cy="64" r="5" fill="#f2c08a" stroke="#2d2a26" stroke-width="2" />

	<!-- eyes -->
	<circle cx="52" cy="60" r="2.4" fill="#2d2a26" />
	<circle cx="68" cy="60" r="2.4" fill="#2d2a26" />

	<!-- moustache -->
	<path
		d="M44 70c4 5 9 7 16 7s12-2 16-7c-2 5-8 9-16 9s-14-4-16-9z"
		fill="#5a4634"
		stroke="#2d2a26"
		stroke-width="1.5"
		stroke-linejoin="round"
	/>

	<!-- smile -->
	<path d="M53 76c3 3 11 3 14 0" fill="none" stroke="#2d2a26" stroke-width="2" stroke-linecap="round" />

	<!-- bow tie -->
	<path d="M52 85l8 5 8-5-8 10z" fill="#c23b3b" stroke="#2d2a26" stroke-width="1.5" stroke-linejoin="round" />

	<!-- jacket -->
	<path
		d="M32 118c1-16 10-26 28-26s27 10 28 26z"
		fill="#ffffff"
		stroke="#2d2a26"
		stroke-width="2.5"
		stroke-linejoin="round"
	/>
	<path d="M60 92v26" stroke="#2d2a26" stroke-width="1.5" />

	<!-- raised arm + thumbs up -->
	<path
		d="M82 100c4-6 7-13 6-20"
		fill="none"
		stroke="#ffffff"
		stroke-width="9"
		stroke-linecap="round"
	/>
	<path
		d="M82 100c4-6 7-13 6-20"
		fill="none"
		stroke="#2d2a26"
		stroke-width="2.5"
		stroke-linecap="round"
	/>
	<g transform="translate(83 72) rotate(-18)">
		<rect x="-6" y="-4" width="13" height="16" rx="4" fill="#f2c08a" stroke="#2d2a26" stroke-width="2" />
		<rect x="-2" y="-14" width="7" height="12" rx="3.2" fill="#f2c08a" stroke="#2d2a26" stroke-width="2" />
	</g>
</svg>
