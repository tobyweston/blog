---
import { Image } from 'astro:assets';
import mascot from '../../assets/chef-mascot.png';

// Circular mascot medallion used by ExampleCallout.
interface Props {
	alt?: string;
	class?: string;
}

const { alt = 'Illustration of a chef giving a thumbs up', class: className } = Astro.props;
---

<div class={`chef-mascot ${className ?? ''}`.trim()}>
	<Image src={mascot} alt={alt} width={88} height={88} densities={[2, 3]} loading="lazy" decoding="async" />
</div>

<style>
	.chef-mascot {
		aspect-ratio: 1;
		border-radius: 50%;
		overflow: hidden;
		background: #ffffff;
		border: 3px solid #1b1b2f;
		/* keeps the ring crisp while the image is cropped inside it */
		isolation: isolate;
	}

	.chef-mascot :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		/* prose styles give images a 2rem block margin, which would push the
		   artwork down out of the circle */
		margin: 0;
		border-radius: 0;
	}
</style>
