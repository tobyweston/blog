---
import {getCollection} from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../components/ui/SiteLayout.astro';
import PreviewBlog from '../../components/ui/PreviewBlog.astro';
import RobotCaneCard from "../../components/ui/RobotCaneCard.astro";

const posts = (await getCollection('blog')) as CollectionEntry<'blog'>[];
posts.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Every card on the page is rendered here by PreviewBlog, so a card has exactly
// one definition. Cards past the first batch are held at display:none via
// .card-reveal[data-pending]; the script below drops that attribute a batch at a
// time as the sentinel comes into view. A hidden card has no layout box, so the
// browser does not fetch its hero image until the card is actually shown.
const perPage = 5;
---

<SiteLayout title="Blog - bad.robot" description="Good Robots do what they're told!">
  <section>
    <h1 class="page-header mb-6">Blog</h1>
    <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {posts.slice(0, perPage).map((p: CollectionEntry<'blog'>, idx: number) => (
        <div class="card-reveal" data-card-idx={idx}>
          <PreviewBlog post={p} />
        </div>
      ))}
      <div class="card-reveal" data-card-idx={perPage}>
        <RobotCaneCard />
      </div>
      {posts.slice(perPage).map((p: CollectionEntry<'blog'>, idx: number) => (
        <div class="card-reveal" data-card-idx={perPage + 1 + idx} data-pending>
          <PreviewBlog post={p} />
        </div>
      ))}
    </div>

    {posts.length > perPage && (
      <div id="loading-indicator" class="mt-8 text-center hidden">
        <div class="inline-flex items-center px-4 py-2 text-gray-600">
          <div class="bouncing-loader mr-3">
            <div></div>
            <div></div>
            <div></div>
          </div>
        </div>
      </div>
    )}

    <div id="scroll-sentinel" class="h-4"></div>
  </section>

  <style>
    .bouncing-loader {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .bouncing-loader > div {
      width: 0.75rem;
      height: 0.75rem;
      background-color: var(--accent, #2337ff);
      border-radius: 50%;
      animation: bounce 1.4s infinite ease-in-out both;
    }

    .bouncing-loader > div:nth-child(1) {
      animation-delay: -0.32s;
    }

    .bouncing-loader > div:nth-child(2) {
      animation-delay: -0.16s;
    }

    @keyframes bounce {
      0%, 80%, 100% {
        transform: scale(0.6);
        opacity: 0.5;
      }
      40% {
        transform: scale(1);
        opacity: 1;
      }
    }
  </style>

  <script is:inline type="module" define:vars={{perPage}}>
    // Animation timing constants (matching Hero component aesthetic)
    const CARD_REVEAL_DELAY = 80; // ms between each card
    const ITEM_REVEAL_DELAY = 60; // ms between items within a card
    const INDICATOR_HOLD = 1000;  // ms the loader shows before a batch appears

    const postsGrid = document.getElementById('posts-grid');
    const loadingIndicator = document.getElementById('loading-indicator');
    const sentinel = document.getElementById('scroll-sentinel');

    let observer;
    let revealing = false;

    function animateCard(cardElement, cardIndex) {
      const cardDelay = cardIndex * CARD_REVEAL_DELAY;
      setTimeout(() => cardElement.classList.add('revealed'), cardDelay);
      cardElement.querySelectorAll('.card-item-reveal').forEach((item, itemIndex) => {
        setTimeout(() => item.classList.add('revealed'), cardDelay + (itemIndex + 1) * ITEM_REVEAL_DELAY);
      });
    }

    function pendingCards() {
      return Array.from(postsGrid?.querySelectorAll('.card-reveal[data-pending]') || []);
    }

    function stopObserving() {
      if (sentinel) sentinel.style.display = 'none';
      observer?.disconnect();
    }

    function revealNextBatch() {
      if (revealing) return;

      const batch = pendingCards().slice(0, perPage);
      if (!batch.length) {
        stopObserving();
        return;
      }

      revealing = true;
      loadingIndicator?.classList.remove('hidden');

      // Hold the loader for a beat so a batch does not snap into place.
      setTimeout(() => {
        batch.forEach((card, idx) => {
          card.removeAttribute('data-pending');
          animateCard(card, idx);
        });

        revealing = false;
        loadingIndicator?.classList.add('hidden');

        if (!pendingCards().length) stopObserving();
      }, INDICATOR_HOLD);
    }

    // Animate the cards that start out visible.
    postsGrid?.querySelectorAll('.card-reveal:not([data-pending])')
      .forEach((card, idx) => animateCard(card, idx));

    if (sentinel && pendingCards().length) {
      observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) revealNextBatch();
        },
        { rootMargin: '200px' },
      );
      observer.observe(sentinel);
    } else {
      stopObserving();
    }
  </script>
</SiteLayout>
